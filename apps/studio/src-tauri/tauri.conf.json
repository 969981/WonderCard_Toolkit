{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WonderCard Pro Editor",
  "version": "0.4.0",
  "identifier": "io.github.wondercard.toolkit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WonderCard Pro Editor",
        "width": 1360,
        "height": 900,
        "minWidth": 920,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
