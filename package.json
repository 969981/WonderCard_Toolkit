{
  "name": "wondercard-toolkit-workspace",
  "private": true,
  "version": "0.4.0-alpha.0",
  "workspaces": [
    "apps/studio"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@wondercard/studio",
    "build": "npm run build --workspace=@wondercard/studio",
    "test": "npm run test --workspace=@wondercard/studio",
    "typecheck": "npm run typecheck --workspace=@wondercard/studio",
    "tauri": "npm run tauri --workspace=@wondercard/studio",
    "test:legacy": "python -m unittest discover -s tests -p 'test_legacy_core.py' -v"
  }
}
